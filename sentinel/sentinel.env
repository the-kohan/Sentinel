# Sentinel environment variables
# Fill these in from your own environment.
# This file is gitignored. Use sentinel.env.example for the template.

TELEGRAM_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
POSTGRES_USER=<YOUR_POSTGRES_USER>
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=sentinel_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
N8N_WEBHOOK=<YOUR_N8N_WEBHOOK_URL>
SENTINEL_ROOT=/mnt/d/kohanastack/sentinel
SENTINEL_HOOK_TOKEN=<YOUR_OPENCLAW_HOOK_TOKEN>
